{
  "uid": "retnd-backup-health",
  "title": "Backup health",
  "description": "retnd's FR-24 health report as Prometheus sees it: state, freshness, failures, quarantine and capacity. Part of the example observability bundle in container/observability, which is not a supported deployment.",
  "tags": [
    "retnd",
    "example"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "backup_set",
        "label": "Backup set",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(retnd_backup_set_state, backup_set)",
          "refId": "backup_set"
        },
        "definition": "label_values(retnd_backup_set_state, backup_set)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is retnd being scraped",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape answering (1 when nothing is wrong)",
      "description": "Prometheus's own reading of the scrape. 0 means the engine did not answer or refused the credential; no data means Prometheus has no retnd job at all. Every other panel on this page is empty in both cases, which is why this one is first.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"retnd\"}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Health report age (under a minute when nothing is wrong)",
      "description": "How old the health report behind this scrape is. The engine rebuilds it at most every observability.metrics.min_rebuild_interval (15s by default), so with a 15s scrape this stays well under a minute. A number that keeps climbing is a report the engine has stopped rebuilding.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "time() - retnd_report_generated_timestamp_seconds",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Backup sets not healthy (0 when nothing is wrong)",
      "description": "How many of the selected backup sets are degraded, stale or failing right now. The state panel beside it says which.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(retnd_backup_set_state{state!=\"healthy\", backup_set=~\"$backup_set\"})",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Irrecoverably quarantined artifacts (0 when nothing is wrong)",
      "description": "Artifacts at QUARANTINED_LOST across the selected sets. Anything above 0 is a backup this manager knows it cannot restore.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(retnd_backup_set_quarantined_lost{backup_set=~\"$backup_set\"})",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "State",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "table",
      "title": "State per backup set (every row reads healthy when nothing is wrong)",
      "description": "One row per backup set with the state FR-24 decided for it. The reason behind a state that is not healthy is on the status surface (retnd status, or the Web UI), never a label here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "retnd_backup_set_state{backup_set=~\"$backup_set\"} == 1",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Freshness",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Newest good backup age as a share of its stale threshold (stays below 100% when nothing is wrong)",
      "description": "The age of each set's newest known-good backup divided by that set's stale_after. A line reaching 100% is a set about to turn stale. A set with no known-good backup yet has no line, which is not the same as a fresh one.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (backup_set) (retnd_backup_set_newest_good_backup_age_seconds{backup_set=~\"$backup_set\"}) / max by (backup_set) (retnd_backup_set_stale_threshold_seconds{backup_set=~\"$backup_set\"})",
          "legendFormat": "{{backup_set}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Seconds since the last successful discovery poll (a low sawtooth when nothing is wrong)",
      "description": "Each set's time since discovery last completed. It resets every poll, so a healthy set draws a sawtooth no taller than its poll interval. A line that climbs without resetting is a source this manager can no longer list.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "time() - retnd_backup_set_last_successful_poll_timestamp_seconds{backup_set=~\"$backup_set\"}",
          "legendFormat": "{{backup_set}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Failures",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Failed artifacts (0 when nothing is wrong)",
      "description": "Artifacts currently FAILED, per set. A failure that retries clears itself; one that stays is what turns a set FAILING.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "retnd_backup_set_failures{backup_set=~\"$backup_set\"}",
          "legendFormat": "{{backup_set}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Failing relocations (0 when nothing is wrong)",
      "description": "Open moves whose last attempt failed, per set. This is the count that turns an otherwise healthy set DEGRADED; how long the oldest has been failing is in retnd_backup_set_failed_move_oldest_age_seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "retnd_backup_set_failed_moves{backup_set=~\"$backup_set\"}",
          "legendFormat": "{{backup_set}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Quarantine",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Quarantined artifacts, irrecoverable ones separately (both 0 when nothing is wrong)",
      "description": "Every quarantined artifact per set, recoverable or not, and the irrecoverable (QUARANTINED_LOST) subset on its own line so it is never read as the recoverable kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "retnd_backup_set_quarantined{backup_set=~\"$backup_set\"}",
          "legendFormat": "{{backup_set}} quarantined",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "retnd_backup_set_quarantined_lost{backup_set=~\"$backup_set\"}",
          "legendFormat": "{{backup_set}} lost",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Capacity",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Free bytes on each local destination (flat or falling slowly when nothing is wrong)",
      "description": "Free space on each set's local destination filesystem. A set whose free space this manager could not read has no line.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "retnd_backup_set_free_bytes{backup_set=~\"$backup_set\"}",
          "legendFormat": "{{backup_set}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Free bytes a week from now at the last day's rate (stays above 0 when nothing is wrong)",
      "description": "A straight-line projection of each destination's free space seven days ahead, from the last 24 hours. It is a projection, not a promise: a retention run that frees space bends it back up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "predict_linear(retnd_backup_set_free_bytes{backup_set=~\"$backup_set\"}[1d], 7 * 86400)",
          "legendFormat": "{{backup_set}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "transparent",
                "value": 0
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "retnd log lines in the last hour (above 0 when nothing is wrong and logs are shipped)",
      "description": "How many lines Loki holds from retnd for the last hour. 0 or no data means the log pipeline is not wired (see the bundle README), and then the panel beside this one is empty for that reason, not because nothing was logged.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"retnd\"}[1h]))",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 21,
      "type": "logs",
      "title": "retnd warnings and errors (few or none when nothing is wrong)",
      "description": "Every warn and error line retnd wrote. The line is JSON; open one to see its event, action_id and backup_set fields, which are fields and deliberately not labels.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 50,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "expr": "{job=\"retnd\", level=~\"warn|error\"} | json",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      }
    }
  ]
}
