      "module": "pages/storageDestinationCommands",
      "fn": "showCommand",
      "case": "a destination",
      "line": "retnd medium show offsite_s3"
    },
    {
      "module": "pages/storageDestinationCommands",
      "fn": "showCommand",
      "case": "a hostile id",
