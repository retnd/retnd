{
  "_doc": "The activity-feed lines the engine emitted for one recovery and one recovery test of a local copy, in the order it emitted them: start, then each stage, then end. 'stages' is the stage ids alone. The CLI's --follow (core/cmd/retnd/recoverfollow_test.go) must print exactly these stages in this order, and the browser's follow (W-12a) must render the same. Regenerate with UPDATE_RECOVERY_FEED=1 go test ./cmd/retnd -run TestRecordedRecoveryFeedIsCurrent.",
  "recover": {
    "stages": [
      "resolving_copy",
      "reading",
      "verifying",
      "writing_target",
      "cleaning_temporary_files",
      "complete"
    ],
    "events": [
      {
        "event": "recovery_start"
      },
      {
        "event": "recovery_stage",
        "stage": "resolving_copy",
        "stage_label": "Resolving copy"
      },
      {
        "event": "recovery_stage",
        "stage": "reading",
        "stage_label": "Reading"
      },
      {
        "event": "recovery_stage",
        "stage": "verifying",
        "stage_label": "Verifying"
      },
      {
        "event": "recovery_stage",
        "stage": "writing_target",
        "stage_label": "Writing target"
      },
      {
        "event": "recovery_stage",
        "stage": "cleaning_temporary_files",
        "stage_label": "Cleaning temporary files"
      },
      {
        "event": "recovery_stage",
        "stage": "complete",
        "stage_label": "Complete"
      },
      {
        "event": "recovery_end",
        "result": "success"
      }
    ]
  },
  "recovery_test": {
    "stages": [
      "resolving_copy",
      "complete"
    ],
    "events": [
      {
        "event": "recovery_test_start"
      },
      {
        "event": "recovery_stage",
        "stage": "resolving_copy",
        "stage_label": "Resolving copy"
      },
      {
        "event": "recovery_stage",
        "stage": "complete",
        "stage_label": "Complete"
      },
      {
        "event": "recovery_test_end",
        "result": "warn"
      }
    ]
  }
}
