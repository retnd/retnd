PATCH /auth/recovery
	corpus: command
	example {"currentPassword":"x","recoveryEmail":"ops@example.org"}: command
	example {"currentPassword":"x","smtp":{"host":"smtp.example.org","port":2525,"security":"tls","username":"mailer","from":"retnd@example.org","password":"y"}}: command
	body that isn't JSON: malformed: the request body would not decode, so there is no command that says what it changed

PATCH /backup-sets/{source}/{set}
	corpus: command
	example {"stale_after_seconds":172800}: command
	example {"host":"10.0.0.15","skip_connection_check":true}: command
	example {"stale_after_seconds":30,"stable_for_seconds":600}: command
	example {"stale_after_seconds":3610,"stable_for_seconds":90}: command
	example {"host":"10.0.0.15","port":2222,"user":"backups","remote_path":"/var/backups","local_path":"/data/backups","include":["*.gz","*.sql"],"completion_strategy":"stable","stable_for_seconds":300,"validator_id":"gzip","ssh_key_id":"key_2","known_hosts_line":"10.0.0.15 ssh-ed25519 AAAAC3Nz","acknowledge_repoint":true,"acknowledge_host_key_change":true}: command
	example {"source_consistency":"quiesced","verification_level":"sample","verification_sample_percent":10,"verification_full_every_seconds":604800,"verification_restore_drill_every_seconds":2592000}: command
	example {"poll_interval_seconds":900}: command
	example {"poll_interval_seconds":0}: command
	body that isn't JSON: malformed: there is no verb that edits a backup set from a request body

