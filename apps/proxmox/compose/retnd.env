# Environment for retnd.yml (WP4.5, deliverable D-9).
#
# Copy both files into the guest — never onto the Proxmox VE host — and
# put this one next to the compose file as `.env`.
#
# Nothing in this file is a secret. It only points at where things live
# inside the guest: the SSH private key stays wherever KEY_FILE points,
# owned by you, never checked into this repository and never baked into
# the image. distribution/packaging scans this file for credential
# material on every commit.
#
# THE ONE SUBSTITUTION THAT MATTERS
#
# Every path below is inside the GUEST. /mnt/backupd is where the
# guest sees the PVE host directory or dataset you shared into it (a
# virtiofs or NFS mapping for a VM, `pct set <id> --mp0` for the LXC
# variant). If you mounted it somewhere else, change the five paths below
# and nothing else.

# The canonical OCI image. It is real, published, keyless-signed and
# SBOM-attested (distribution/packaging/canonical.json records
# image.published: true; container/release-manifest.json carries a real
# registry_digest per architecture) -- it resolves as pulled, no push or
# side-load needed; see step 0.5 of docs/acceptance/proxmox-ve-deployment.md
# for the locally-built-image path instead. Change it here and nowhere
# else.
IMAGE=ghcr.io/retnd/retnd:0.4.0

# The account the containers run as. Must already own STATE_DIR and
# BACKUP_DIR: the runtime image is distroless, with no shell and no root
# step, so nothing inside the container can chown them at startup. If the
# host directory is shared into an unprivileged LXC, remember the id
# mapping — the owning uid inside the guest is not the owning uid on the
# PVE host.
PUID=1000
PGID=100

# Private application state: the SQLite catalog and the
# local-authentication administrator record (an Argon2id hash, never a
# plaintext password).
STATE_DIR=/mnt/backupd/state

# The user backup root: where retained artifacts land. A separate security
# domain from everything above (§19.2), so no key material or
# authentication state ever lives inside it.
BACKUP_DIR=/mnt/backupd/backups

# The engine loads and validates CONFIG_DIR/config.yaml before it
# opens a listener, so it must exist and be valid before the first start.
CONFIG_DIR=/mnt/backupd/config
KEY_FILE=/mnt/backupd/secrets/id_ed25519
KNOWN_HOSTS_FILE=/mnt/backupd/secrets/known_hosts

# The Host Workflow Runner's three paths (issue #921). Local workflow
# hooks are available in this deployment — step 9 of
# docs/acceptance/proxmox-ve-deployment.md — and the runner is installed
# inside this guest with scripts/install/install_docker_host.py. These
# three are what the engine sees of it: the hook scripts it reads, the
# directory the runner's socket appears in, and the token it
# authenticates with. Point the installer at the same three.
#
# All three fail closed in retnd.yml, like every other host path here:
# an unset one stops the deployment rather than letting Docker create a
# bind source on the guest's root disk that the hooks would then read
# nothing out of. A deployment that runs no local hooks still sets them
# and simply leaves the directories empty, which the runner's own
# preflight treats as "no hooks here"; one that points the installer
# somewhere else gets a refusal at the first hook rather than a hook
# that silently does nothing.
WORKFLOWS_DIR=/mnt/backupd/workflows
RUNTIME_DIR=/mnt/backupd/run
RUNNER_TOKEN_FILE=/mnt/backupd/secrets/workflow-runner.token

# Retention is evaluated against calendar boundaries, so this is not
# cosmetic. Set it to this host's own timezone.
TZ=UTC

# The host port the Web UI is published on, inside the guest. It has
# nothing to do with the PVE Web UI's own 8006, which this profile never
# touches.
WEB_PORT=8080

# Externally reachable base URL for the one-time enrollment link the
# engine prints on first start. "localhost" is only right when you open
# the link on the guest itself; set the guest's real name or address to
# get a link that works from another machine.
PUBLIC_BASE_URL=http://localhost:8080
