{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // The tooltip registry (src/tooltips/tooltips.json, issue #834) is
    // imported as a module so its keys ARE the `TooltipId` union: an
    // element naming an id the registry does not define fails to compile,
    // which is the only check that covers several hundred call sites no
    // test run visits.
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/*"
      ],
      "@platform-entry": [
        "../../apps/generic/frontend/bootstrap.tsx"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  // "include" is deliberately `src` and nothing else. This is the browser
  // program: widening it to reach vite.config.ts would mean adding
  // @types/node and putting "node" in "types", which makes Node's globals
  // type-visible to every component under src/ too. So vite.config.ts is
  // linted but not type-checked, and no compiler option set here should be
  // read as a coverage claim about any path outside src/. Unused code
  // outside src/ is eslint.config.js's job, and it owns that whole job on
  // its own (issue #219); apps/*/frontend is type-checked separately by
  // tsconfig.providers.json.
  "include": [
    "src"
  ]
}
