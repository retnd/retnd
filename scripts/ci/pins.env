# The toolchain the gate is pinned to (#1260). One file, read by four
# things, so none of them can drift from the others:
#
#   * scripts/ci-local.sh ledgers a run whose golangci-lint is not this
#     version (the run ends INCOMPLETE and says which it found), and names
#     this version in its install hint when there is none;
#   * scripts/ci-docker.sh builds scripts/ci/Dockerfile with it;
#   * scripts/release/record-local-gate.sh records what the gate printed,
#     and scripts/release/verify-local-gate.sh refuses a record made with
#     another version.
#
# Go is NOT pinned here. The language version is core/go.mod's `go` line,
# which the release check compares the record against at major.minor, and
# the toolchain a run uses is the one its golangci-lint was built with
# (ci-local.sh exports GOTOOLCHAIN from that), because a linter can only
# read export data written by its own Go or an older one.
#
# This used to be read out of .github/workflows/ci.yml with a silenced
# sed, which went on returning nothing after #1260 deleted that file, so
# the pin note could never fire and the hint printed a literal <ci pin>.
#
# Plain KEY=VALUE, no `v` prefix, no shell.
GOLANGCI_LINT_VERSION=2.15.0
