#!/usr/bin/env sh
# The gate, on every commit. The only gate (#1260).
#
# GitHub Actions gates nothing in this repository: ci.yml is gone, and no
# workflow produces a check that stands in front of `main` or `release`.
# This hook, via scripts/ci-local.sh, IS the CI, and a release is refused
# unless a full green run of that script is recorded on the tree it
# publishes (scripts/release/record-local-gate.sh). It is installed with
# `bash scripts/install-hooks.sh`, once per clone, which sets
# core.hooksPath=.husky in the shared config so every worktree runs it.
#
# This makes commits slow (the full core/ suite includes the Docker-backed
# crash matrix and SFTP integration tests, plus two cross-compiles, three
# frontend installs/builds, and the dependency-rules worktree-deletion
# proofs). That's the deliberate tradeoff of relying on this instead of
# GitHub Actions: see scripts/ci-local.sh's own header for the CI_LOCAL_FAST
# escape hatch for iteration, and never rely on it before a merge.
#
# In a fresh clone or a new `git worktree`, the first commit stops before it
# runs anything: node_modules/ is gitignored, and since #160 the gate refuses
# to report on frontend and conformance checks it cannot perform instead of
# skipping them and printing "ci-local: ok" anyway. It names every
# uninstalled workspace and the command that fixes it. Run those, or set
# CI_LOCAL_SKIP_JS=1 to leave them out on purpose. The same now goes for a
# stopped Docker daemon and CI_LOCAL_SKIP_DOCKER=1.
#
# Three outcomes, and this hook has to make its own decision about the
# middle one rather than inherit it by accident:
#
#   0  the gate performed every applicable check          -> commit
#   3  the gate ran but skipped something (INCOMPLETE)    -> commit, loudly
#   *  something actually failed                          -> block
#
# Tolerating 3 is the policy that keeps CI_LOCAL_FAST=1 usable for iteration,
# and it belongs here, where a human reads the warning, rather than inside
# the gate where it would look like success. Anything that merges on this
# gate's word must require 0, and the release does: its record is written
# only on 0.
#
# What makes tolerating it safe is that 3 means exactly one thing by the
# time it arrives here, and that stopped being free while this hook stood
# still. Three other things in this repository speak that number: the
# CLI returns it for a refusal of its own (#551, another process is
# already serving this deployment), gotestwatch's test binary returns
# it for a control it could not measure, and golangci-lint returns it when
# it will not run beside another instance (#1260). None reaches this hook
# wearing it. The two-machine proof keeps its own verdict on a status
# nothing else produces and translates once at its exit
# (scripts/tests/two-machine-exit-status.test.sh pins that), the gate
# reads gotestwatch's 3 into its skip ledger rather than passing it up,
# and gate_lint turns golangci-lint's 3 into a failure. If a fourth thing
# starts speaking 3, it belongs in that list before this hook's tolerance
# can stay as it is.
#
# RED TESTS FIRST. Tests go in red, ahead of their fix, and this hook
# blocks a failing commit. The way through used to be --no-verify, which
# skips every check and leaves nothing in history. It is this instead:
#
#   CI_LOCAL_RED="<why, at least 12 characters>" git commit ...
#
# The gate is skipped, and only when every staged file is a test file
# (*_test.go, *.test.ts, *.spec.tsx, scripts/tests/, scripts/bdtools/tests/,
# test_*.py, a testdata/ directory, and the like: the list is below), never
# on main or release, and never without a reason, which is the same
# twelve-character floor Release-Gate-Override has. prepare-commit-msg
# then stamps `Local-Gate: red <why>` on the commit, so a reviewer sees why
# the gate did not run, right in the history. A product file riding along
# with the red tests is a fix, and the gate exists to run on fixes, so it
# is refused by name.
#
# --no-verify still exists and nothing can stop it, but it is not the
# documented route any more: git runs prepare-commit-msg even then, and it
# stamps `Local-Gate: unverified` on the commit, so a bypass shows up in
# history rather than looking like a gated commit.
#
# THE MARKER. prepare-commit-msg cannot see whether this hook ran, so this
# hook leaves it a note: the tree being committed (`git write-tree` of the
# index, which is what git is about to commit) and what happened to it,
# at `git rev-parse --git-path local-gate-marker`, which is per worktree.
# A --no-verify commit leaves no marker for its tree and is stamped
# unverified; a rebase runs neither hook and keeps whatever the replayed
# commits already carried, which is why a gated commit carries no stamp at
# all (an `ok` would outlive the tree it described).

set -e

# The tree git is about to commit. Written before anything else, so the
# marker names exactly what this hook was asked about.
tree="$(git write-tree)"
marker="$(git rev-parse --git-path local-gate-marker)"

if [ -n "${CI_LOCAL_RED+set}" ]; then
  reason="$CI_LOCAL_RED"
  if [ "${#reason}" -lt 12 ]; then
    echo "==> pre-commit: refusing a red commit with a reason of ${#reason} characters: [$reason]." >&2
    echo "    CI_LOCAL_RED needs at least 12 characters, the same floor as Release-Gate-Override, because" >&2
    echo "    the reason is stamped on the commit and is the whole explanation a reviewer gets." >&2
    exit 1
  fi
  branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo '(detached)')"
  case "$branch" in
    main|release)
      echo "==> pre-commit: refusing a red commit on $branch. Red tests go on a branch and reach $branch with their fix." >&2
      exit 1
      ;;
  esac
  staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
  if [ -z "$staged" ]; then
    echo "==> pre-commit: refusing a red commit with nothing staged." >&2
    exit 1
  fi
  offenders=""
  for path in $staged; do
    case "$path" in
      *_test.go|*.test.ts|*.test.tsx|*.test.js|*.test.mjs|*.spec.ts|*.spec.tsx|*.test.sh) ;;
      scripts/tests/*|scripts/bdtools/tests/*) ;;
      */testdata/*|testdata/*) ;;
      */test_*.py|test_*.py|*_test.py) ;;
      *) offenders="$offenders
        $path" ;;
    esac
  done
  if [ -n "$offenders" ]; then
    echo "==> pre-commit: refusing a red commit: these staged files are not test files, so this is a fix and the gate has to run on it:" >&2
    echo "$offenders" >&2
    echo "    Commit the red tests on their own with CI_LOCAL_RED, then the fix without it." >&2
    exit 1
  fi
  printf 'red %s %s\n' "$tree" "$reason" >"$marker"
  echo "==> pre-commit: red commit, the gate did not run. Reason: $reason"
  echo "    Only test files are staged, this is $branch, and the commit will carry Local-Gate: red."
  exit 0
fi

gate_status=0
bash scripts/ci-local.sh || gate_status=$?

if [ "$gate_status" -eq 0 ]; then
  printf 'verified %s\n' "$tree" >"$marker"
  exit 0
fi

if [ "$gate_status" -eq 3 ]; then
  printf 'incomplete %s\n' "$tree" >"$marker"
  echo "" >&2
  echo "==> pre-commit: allowing this commit on an INCOMPLETE gate run." >&2
  echo "    The checks listed above did not run, so this commit is not backed by" >&2
  echo "    merge evidence. Run scripts/ci-local.sh with CI_LOCAL_FAST," >&2
  echo "    CI_LOCAL_SKIP_JS and CI_LOCAL_SKIP_DOCKER unset before you merge." >&2
  exit 0
fi

exit "$gate_status"
