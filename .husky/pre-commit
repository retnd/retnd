#!/usr/bin/env sh
# The hook: the fast tier on every commit (#1361), the full gate on the
# release PR.
#
# GitHub Actions gates nothing in this repository: ci.yml is gone, and no
# workflow produces a check that stands in front of `main` or `release`.
# This hook is installed with `bash scripts/install-hooks.sh`, once per
# clone, which sets core.hooksPath=.husky in the shared config so every
# worktree runs it.
#
# What it runs is scripts/ci-fast.sh --staged: the anchors check, the
# contract drift check, gofmt, and vet, lint and tests on the packages the
# staged files are in (read that script's header for the whole list). It
# used to run scripts/ci-local.sh, the full gate, on every commit: the
# Docker crash matrix, the cross-compiles, three frontend builds. That took
# the better part of an hour, so the way people committed became
# --no-verify, and 144 of the 146 stamped commits on main said so (#1361).
# A gate people keep switched on and that checks less beats one they skip.
#
# The full gate is still the thing a release is refused without
# (scripts/release/record-local-gate.sh writes the record the release
# reads), and it is still available here: CI_LOCAL_FULL=1 git commit ...
# runs it, and a green full run is the only thing that leaves a commit
# with no Local-Gate trailer.
#
# THE HOOKS PATH. This hook refuses to run when core.hooksPath is an
# absolute path, or resolves to some other checkout's .husky, or when the
# file being run is not this checkout's own .husky/pre-commit. That is how
# a stale checkout's September hook ended up running in every worktree,
# with no red-tests route and no stamping (#1361). The fix is one command,
# and the refusal names it: bash scripts/install-hooks.sh.
#
# In a fresh clone or a new `git worktree` the first commit no longer stops
# for missing node_modules/: the fast tier only needs a JS workspace when
# a staged path is in it (ci-fast.sh names the command that installs it, or
# CI_LOCAL_SKIP_JS=1 leaves it out on purpose). The full gate, under
# CI_LOCAL_FULL=1, still refuses as it always did (#160).
#
# Three outcomes, and this hook has to make its own decision about the
# middle one rather than inherit it by accident:
#
#   0  the gate performed every applicable check          -> commit
#   3  the gate ran but skipped something (INCOMPLETE)    -> commit, loudly
#   *  something actually failed                          -> block
#
# Tolerating 3 is the policy that keeps CI_LOCAL_FAST=1 usable for iteration,
# and it belongs here, where a human reads the warning, rather than inside
# the gate where it would look like success. Anything that merges on this
# gate's word must require 0, and the release does: its record is written
# only on 0.
#
# What makes tolerating it safe is that 3 means exactly one thing by the
# time it arrives here, and that stopped being free while this hook stood
# still. Three other things in this repository speak that number: the
# CLI returns it for a refusal of its own (#551, another process is
# already serving this deployment), gotestwatch's test binary returns
# it for a control it could not measure, and golangci-lint returns it when
# it will not run beside another instance (#1260). None reaches this hook
# wearing it. The two-machine proof keeps its own verdict on a status
# nothing else produces and translates once at its exit
# (scripts/tests/two-machine-exit-status.test.sh pins that), the gate
# reads gotestwatch's 3 into its skip ledger rather than passing it up,
# and gate_lint turns golangci-lint's 3 into a failure. If a fourth thing
# starts speaking 3, it belongs in that list before this hook's tolerance
# can stay as it is.
#
# RED TESTS FIRST. Tests go in red, ahead of their fix, and this hook
# blocks a failing commit. The way through used to be --no-verify, which
# skips every check and leaves nothing in history. It is this instead:
#
#   CI_LOCAL_RED="<why, at least 12 characters>" git commit ...
#
# The gate is skipped, and only when every staged file is a test file
# (*_test.go, *.test.ts, *.spec.tsx, scripts/tests/, scripts/bdtools/tests/,
# test_*.py, a testdata/ directory, and the like: the list is below), never
# on main or release, and never without a reason, which is the same
# twelve-character floor Release-Gate-Override has. prepare-commit-msg
# then stamps `Local-Gate: red <why>` on the commit, so a reviewer sees why
# the gate did not run, right in the history. A product file riding along
# with the red tests is a fix, and the gate exists to run on fixes, so it
# is refused by name.
#
# --no-verify still exists and nothing can stop it, but it is not the
# documented route any more: git runs prepare-commit-msg even then, and it
# stamps `Local-Gate: unverified` on the commit, so a bypass shows up in
# history rather than looking like a gated commit.
#
# THE MARKER. prepare-commit-msg cannot see whether this hook ran, so this
# hook leaves it a note: the tree being committed (`git write-tree` of the
# index, which is what git is about to commit) and what happened to it,
# at `git rev-parse --git-path local-gate-marker`, which is per worktree.
# A --no-verify commit leaves no marker for its tree and is stamped
# unverified; a rebase runs neither hook and keeps whatever the replayed
# commits already carried, which is why a gated commit carries no stamp at
# all (an `ok` would outlive the tree it described).

set -e

# The hooks path guard (#1361). Git resolves a relative core.hooksPath
# against each worktree's own root, which is what install-hooks.sh sets. An
# absolute one points every worktree at one checkout's hook, possibly a
# stale one, and nothing about running it says so.
hooks_top="$(git rev-parse --show-toplevel)"
hooks_want="$(cd "$hooks_top/.husky" 2>/dev/null && pwd -P || true)"
hooks_here="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P || true)"
hooks_cfg="$(git config --get core.hooksPath || true)"
hooks_bad=""
case "$hooks_cfg" in
  /* | "~"*) hooks_bad="core.hooksPath is an absolute path ($hooks_cfg)" ;;
  "") ;;
  *)
    hooks_got="$(cd "$hooks_top" && cd "$hooks_cfg" 2>/dev/null && pwd -P || true)"
    if [ "$hooks_got" != "$hooks_want" ]; then
      hooks_bad="core.hooksPath ($hooks_cfg) does not resolve to this checkout's .husky"
    fi
    ;;
esac
if [ -z "$hooks_bad" ] && [ -z "$hooks_want" ]; then
  hooks_bad="this checkout has no .husky directory"
fi
if [ -z "$hooks_bad" ] && [ "$hooks_here" != "$hooks_want" ]; then
  hooks_bad="this hook is $hooks_here/pre-commit, not $hooks_top/.husky/pre-commit"
fi
if [ -n "$hooks_bad" ]; then
  echo "==> pre-commit: refusing to run. $hooks_bad." >&2
  echo "    A hook from another checkout can be a stale one: it may have no red-tests route and no" >&2
  echo "    Local-Gate stamping, and nothing it prints would say so. Fix, once per clone (covers every" >&2
  echo "    worktree): bash scripts/install-hooks.sh" >&2
  exit 1
fi

# The tree git is about to commit. Written before anything else, so the
# marker names exactly what this hook was asked about.
tree="$(git write-tree)"
marker="$(git rev-parse --git-path local-gate-marker)"

if [ -n "${CI_LOCAL_RED+set}" ]; then
  # One line: the reason becomes a trailer, and a trailer with a newline in
  # it is two lines of which the second is not a trailer.
  reason="$(printf '%s' "$CI_LOCAL_RED" | tr '\n\r' '  ')"
  if [ "${#reason}" -lt 12 ]; then
    echo "==> pre-commit: refusing a red commit with a reason of ${#reason} characters: [$reason]." >&2
    echo "    CI_LOCAL_RED needs at least 12 characters, the same floor as Release-Gate-Override, because" >&2
    echo "    the reason is stamped on the commit and is the whole explanation a reviewer gets." >&2
    exit 1
  fi
  branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo '(detached)')"
  case "$branch" in
    main|release)
      echo "==> pre-commit: refusing a red commit on $branch. Red tests go on a branch and reach $branch with their fix." >&2
      exit 1
      ;;
  esac
  # -z, so a name with a space in it is one path and not two; --no-renames,
  # so a product file renamed to a test name shows up as the deletion it
  # is and gets judged under its OLD name as well as its new one. (A name
  # with a newline in it still splits here, since sh cannot read NULs; that
  # can only refuse a commit, never let one through.)
  staged="$(git diff --cached --name-only -z --no-renames --diff-filter=ACMD | tr '\0' '\n')"
  if [ -z "$staged" ]; then
    echo "==> pre-commit: refusing a red commit with nothing staged." >&2
    exit 1
  fi
  offenders=""
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
      *_test.go|*.test.ts|*.test.tsx|*.test.js|*.test.mjs|*.spec.ts|*.spec.tsx|*.test.sh) ;;
      scripts/tests/*|scripts/bdtools/tests/*) ;;
      */testdata/*|testdata/*) ;;
      */test_*.py|test_*.py|*_test.py) ;;
      *) offenders="$offenders
        $path" ;;
    esac
  done <<EOF
$staged
EOF
  if [ -n "$offenders" ]; then
    echo "==> pre-commit: refusing a red commit: these staged files are not test files, so this is a fix and the gate has to run on it:" >&2
    echo "$offenders" >&2
    echo "    Commit the red tests on their own with CI_LOCAL_RED, then the fix without it." >&2
    exit 1
  fi
  printf 'red %s %s\n' "$tree" "$reason" >"$marker"
  echo "==> pre-commit: red commit, the gate did not run. Reason: $reason"
  echo "    Only test files are staged, this is $branch, and the commit will carry Local-Gate: red."
  exit 0
fi

# The gate's output is kept beside the marker, so an INCOMPLETE run's
# ledger can be read back and the first thing it names stamped on the
# commit. A pipe would lose the exit status in sh, so the status goes
# through a file of its own.
gate_log="$(git rev-parse --git-path local-gate-last.log)"
gate_status_file="$(git rev-parse --git-path local-gate-last.status)"
if [ "${CI_LOCAL_FULL:-0}" = "1" ]; then
  gate_tier=full
  gate_cmd="scripts/ci-local.sh"
else
  gate_tier=fast
  gate_cmd="scripts/ci-fast.sh --staged"
fi
# set +e inside the group, or `set -e` above ends the group on the gate's
# own non-zero status before the echo runs (the group is a subshell of the
# pipe, so the setting does not leak out). $gate_cmd is two words on
# purpose.
# shellcheck disable=SC2086
{ set +e; bash $gate_cmd 2>&1; echo "$?" >"$gate_status_file"; } | tee "$gate_log"
gate_status="$(cat "$gate_status_file" 2>/dev/null || echo 1)"

# The gate ran on the working tree; the commit is the index. When the two
# differ the gate checked something other than what is being committed,
# and the commit is stamped unverified rather than carrying a claim about
# a tree nobody ran the gate on (#1261 review, item 8).
if [ "$gate_status" -eq 0 ] || [ "$gate_status" -eq 3 ]; then
  if ! git diff --quiet; then
    printf 'unverified %s\n' "$tree" >"$marker"
    echo "" >&2
    echo "==> pre-commit: the working tree differs from the index (unstaged changes), so the gate" >&2
    echo "    ran on a tree other than the one being committed. The commit is allowed and stamped" >&2
    echo "    Local-Gate: unverified. Stage everything, or stash the rest, for a commit the gate vouches for." >&2
    exit 0
  fi
fi

if [ "$gate_status" -eq 0 ]; then
  # Only the full gate vouches for a tree. The fast tier passing is a
  # fact about how the commit was checked, and it is stamped as one.
  if [ "$gate_tier" = full ]; then
    printf 'verified %s\n' "$tree" >"$marker"
  else
    printf 'fast %s\n' "$tree" >"$marker"
  fi
  exit 0
fi

if [ "$gate_status" -eq 3 ]; then
  skipped="$(sed -n 's/^        - //p' "$gate_log" 2>/dev/null | head -1 | tr -d '\r')"
  printf 'incomplete %s %s\n' "$tree" "$skipped" >"$marker"
  echo "" >&2
  echo "==> pre-commit: allowing this commit on an INCOMPLETE gate run." >&2
  echo "    The checks listed above did not run, so this commit is not backed by" >&2
  echo "    merge evidence. Run scripts/ci-local.sh with CI_LOCAL_FAST," >&2
  echo "    CI_LOCAL_SKIP_JS and CI_LOCAL_SKIP_DOCKER unset before you merge." >&2
  exit 0
fi

exit "$gate_status"
